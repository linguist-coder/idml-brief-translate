1", "file": "Stories/Story_u1b3.xml", "source": ["Turn off the printer and let the print head cool for five minutes. Wipe the head gently with a cotton swab and isopropyl alcohol. Do not use water or sharp tools. Let the head dry before you close the cover."], "target": ["プリンターの電源を切り、プリントヘッドが冷えるまで 5 分間待ちます。綿棒とイソプロピルアルコールでヘッドをやさしく拭きます。水や先のとがった道具は使わないでください。カバーを閉じる前に、ヘッドを乾かしてください。"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NA780DA57-tu1", "file": "Stories/Story_u1ec.xml", "source": ["Old caption, not for print."], "target": ["古いキャプション。印刷しない。"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NCFAFE031-tu1", "file": "Stories/Story_u203.xml", "source": ["Specifications"], "target": ["仕様"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NCFAFE031-tu2", "file": "Stories/Story_u203.xml", "source": ["Print width: 56 mm. Speed: up to 100 mm per second. Interface: USB-C."], "target": ["印字幅: 56 mm。速度: 最大 100 mm/秒。インターフェイス: USB-C。"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NCFAFE031-tu3", "file": "Stories/Story_u203.xml", "source": ["Figure 1. TX-40 rear panel"], "target": ["図 1. TX-40 背面パネル"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFBF1B155-tu1", "file": "Stories/Story_u155.xml", "source": ["Tip: Keep the cover open until the roll clicks into place."], "target": ["ヒント: ロールがカチッとはまるまで、カバーを開けたままにしてください。"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}], "findings": [{"seg_id": "NFFD13CDE-tu4", "rule_id": "B-01", "kind": "term", "method": "machine", "severity": "error", "evidence": "\"POWER\" must stay as written.", "suggestion": "", "src_quote": "POWER", "tgt_quote": "", "seg_version": "9f59528d9990f293", "status": "open"}, {"seg_id": "NFFD13CDE-tu6", "rule_id"