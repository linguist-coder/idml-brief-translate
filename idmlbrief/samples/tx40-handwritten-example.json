{"state": {"run_id": "20261118-072434-3c2647", "input_name": "tx40_ja_base.idml", "input_sha256": "3cb6e59c4fe7dc6f552516a53111da046998d11967acaf048c53765992b3f16a", "xlf_sha256": "57403826d4ac83626c181bfd0f113315a0503a95af003d2797729289be1e54fe", "brief": {"name": "TX-40 quick guide (EN -> JA)", "rules": [{"id": "B-01", "type": "keep", "text": "Do not translate UI button names. POWER stays in English.", "source": "POWER", "target": "", "style": "", "level": "required", "scope": "all", "lang": "ja"}, {"id": "B-02", "type": "styled", "text": "The UI Label style goes on the Japanese colour word.", "source": "green", "target": "緑色", "style": "UI Label", "level": "required", "scope": "all", "lang": "ja"}, {"id": "B-03", "type": "term", "text": "Use the agreed term for label roll.", "source": "label roll", "target": "ラベルロール", "style": "", "level": "required", "scope": "all", "lang": "ja"}, {"id": "B-04", "type": "term", "text": "Use the agreed term for print head.", "source": "print head", "target": "プリントヘッド", "style": "", "level": "required", "scope": "all", "lang": "ja"}, {"id": "B-05", "type": "keep", "text": "Do not translate the product name.", "source": "TX-40", "target": "", "style": "", "level": "required", "scope": "all", "lang": "ja"}, {"id": "B-06", "type": "digits", "text": "Write numbers as digits (two seconds -> 2 秒).", "source": "", "target": "", "style": "", "level": "recommended", "scope": "all", "lang": "ja"}, {"id": "B-07", "type": "free", "text": "Use the polite form (です・ます) in instructions.", "source": "", "target": "", "style": "", "level": "required", "scope": "all", "lang": "ja"}, {"id": "B-08", "type": "free", "text": "Safety-related wording must not be softened or shortened.", "source": "", "target": "", "style": "", "level": "required", "scope": "all", "lang": "ja"}]}, "brief_hash": "710ef06c57297e633227cf94eafcc61e091c5028e6380dc53ff3c770f1858863", "settings": {}, "segs": [{"id": "NFB942B11-tu1", "file": "Stories/Story_u106.xml", "source": ["TX-40 Quick Guide | Page ", {"k": "ph", "i": "1", "r": "<content-1/>"}], "target": ["TX-40 クイックガイド | ページ ", {"k": "ph", "i": "1", "r": "<content-1/>"}], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFFD13CDE-tu1", "file": "Stories/Story_u11d.xml", "source": ["TX-40 Label Printer: Quick Guide"], "target": ["TX-40 ラベルプリンター: クイックガイド"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFFD13CDE-tu2", "file": "Stories/Story_u11d.xml", "source": ["This guide covers setup, loading labels and basic maintenance for the TX-40. Read the ", {"k": "bpt", "i": "1", "r": "<content-1>"}, "safety notes", {"k": "ept", "i": "1", "r": "</content-1>"}, " before you connect the power adapter.", {"k": "ph", "i": "2", "r": "<content-NC3ACE870-rg1-2/>"}], "target": ["このガイドでは、TX-40 のセットアップ、ラベルの装着、基本的なメンテナンスについて説明します。電源アダプターを接続する前に、", {"k": "bpt", "i": "1", "r": "<content-1>"}, "安全上の注意", {"k": "ept", "i": "1", "r": "</content-1>"}, "をお読みください。", {"k": "ph", "i": "2", "r": "<content-NC3ACE870-rg1-2/>"}], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NDFD42C45-tu1", "file": "Stories/Story_u11d.xml", "source": [{"k": "ph", "i": "1", "r": "<content-1/>"}, "\tThe power adapter is sold separately in some regions."], "target": [{"k": "ph", "i": "1", "r": "<content-1/>"}, "\t電源アダプターは、地域によっては別売りです。"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFFD13CDE-tu3", "file": "Stories/Story_u11d.xml", "source": ["Before you start"], "target": ["始める前に"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFFD13CDE-tu4", "file": "Stories/Story_u11d.xml", "source": ["Press and hold the ", {"k": "bpt", "i": "1", "r": "<content-1>"}, "POWER", {"k": "ept", "i": "1", "r": "</content-1>"}, " button for two seconds. The status light turns ", {"k": "bpt", "i": "2", "r": "<content-2>"}, "green", {"k": "ept", "i": "2", "r": "</content-2>"}, " when the printer is ", {"k": "bpt", "i": "3", "r": "<content-3>"}, "ready", {"k": "ept", "i": "3", "r": "</content-3>"}, "."], "target": [{"k": "bpt", "i": "1", "r": "<content-1>"}, "電源", {"k": "ept", "i": "1", "r": "</content-1>"}, " ボタンを 2 秒間押し続けます。プリンターの", {"k": "bpt", "i": "3", "r": "<content-3>"}, "準備ができる", {"k": "ept", "i": "3", "r": "</content-3>"}, "と、ステータスランプが", {"k": "bpt", "i": "2", "r": "<content-2>"}, "緑色", {"k": "ept", "i": "2", "r": "</content-2>"}, "に点灯します。"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFFD13CDE-tu5", "file": "Stories/Story_u11d.xml", "source": ["For cleaning steps, see ", {"k": "ph", "i": "1", "r": "<content-1/>"}, "."], "target": ["清掃の手順については、", {"k": "ph", "i": "1", "r": "<content-1/>"}, "を参照してください。"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFFD13CDE-tu6", "file": "Stories/Story_u11d.xml", "source": ["Use only TX-40 ", {"k": "ph", "i": "1", "r": "<content-1/>"}, "label rolls. Other rolls can jam the feed path."], "target": ["TX-40 専用の", {"k": "ph", "i": "1", "r": "<content-1/>"}, "ラベル巻だけを使用してください。ほかのロールを使うと、給紙経路が詰まることがあります。"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFFD13CDE-tu7", "file": "Stories/Story_u11d.xml", "source": ["Firmware: ", {"k": "bpt", "i": "1", "r": "<content-1>"}, "TX40-FW 2.1.7", {"k": "ept", "i": "1", "r": "</content-1>"}], "target": ["ファームウェア: ", {"k": "bpt", "i": "1", "r": "<content-1>"}, "TX40-FW 2.1.7", {"k": "ept", "i": "1", "r": "</content-1>"}], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFF697A14-tu1", "file": "Stories/Story_u134.xml", "source": ["Loading a label roll"], "target": ["ラベルロールの装着"], "translatable": true, "status": "translated", "note": "", "edited": false, "attempts": 0}, {"id": "NFF697A